# OpenObserve Stack Configuration
# Shared vars (DOMAIN, AUTOLOG_*, DOCKER_LOG_*) are in ../shared/.env

# OpenObserve
ZO_ROOT_USER_EMAIL=admin@example.com
ZO_ROOT_USER_PASSWORD=changeme-strong-password
# Base64 of email:password — used by OTEL collector for auth
# Generate with: echo -n "admin@example.com:yourpassword" | base64
ZO_TOKEN=changeme-base64-token

# Docker container log rotation
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5
