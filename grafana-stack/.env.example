# Domain Configuration
DOMAIN=yourdomain.com

# Grafana Configuration
GRAFANA_ADMIN_PASSWORD=changeme-strong-password
GRAFANA_PROMETHEUS_URL=http://prometheus:9090
GRAFANA_LOKI_URL=http://loki:3100
GRAFANA_TEMPO_URL=http://tempo:3200
GRAFANA_REDIS_URL=redis://redis-autolog:6379

# Auto-logging Service Configuration
AUTOLOG_WEBHOOK_SECRET=changeme-generate-random-string
ERROR_THRESHOLD_COUNT=10
ERROR_THRESHOLD_WINDOW_MINUTES=5
AUTOLOG_TTL_MINUTES=30
AUTOLOG_LOG_LEVEL=INFO

# Retention Configuration (per component)
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=4GB
LOKI_RETENTION=168h
TEMPO_RETENTION=168h

# Docker container log rotation (prevents json-file growth on host disk)
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

# Alertmanager Email Configuration (Optional)
# SMTP server settings for alert notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL=alerts@yourdomain.com
CRITICAL_ALERT_EMAIL=critical@yourdomain.com

# Application-specific environment variables
# These will be used by your instrumented applications

# Jaiye Service
JAIYE_ENVIRONMENT=production
JAIYE_OTEL_ENDPOINT=http://otel-collector:4317

# Add more services as needed
# SERVICE_NAME_ENVIRONMENT=
# SERVICE_NAME_OTEL_ENDPOINT=
