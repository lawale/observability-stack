# Grafana Stack Configuration
# Shared vars (DOMAIN, AUTOLOG_*, DOCKER_LOG_*) are in ../shared/.env

# Grafana
GRAFANA_ADMIN_PASSWORD=changeme-strong-password
GRAFANA_PROMETHEUS_URL=http://prometheus:9090
GRAFANA_LOKI_URL=http://loki:3100
GRAFANA_TEMPO_URL=http://tempo:3200
GRAFANA_REDIS_URL=redis://redis-autolog:6379

# Retention
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=4GB
LOKI_RETENTION=168h
TEMPO_RETENTION=168h

# AlertManager Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL=alerts@yourdomain.com
CRITICAL_ALERT_EMAIL=critical@yourdomain.com
AUTOLOG_WEBHOOK_SECRET=changeme-generate-random-string

# Docker container log rotation
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

# Domain (needed for Grafana root URL)
DOMAIN=yourdomain.com
